# Zhipu AI SDK
ZAI_API_KEY=<your-api-key>
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash
LLM_VISION_MODEL=glm-4v-flash
LLM_VISION_MAX_PAGES=3

# Database
DATABASE_URL=postgresql://user:pass@db:5432/agent_cv

# Storage
UPLOAD_DIR=./data/uploads
REPORT_DIR=./data/reports
CACHE_DIR=./data/cache

# LLM
LLM_TEMPERATURE=0
LLM_SEED=42

# App
DEBUG=true
SECRET_KEY=your-secret-key-here
# JD parser
# JD_PARSER_MODE=rule        # rule | hybrid (LLM refine) | qwen (local model)
# JD_PARSER_LLM_MODEL=       # optional override for the LLM skill refiner
# JD_QWEN_MODEL_ID=Rithankoushik/job-parser-model-qwen
# JD_QWEN_MAX_NEW_TOKENS=512

# Site mode - which job site the screening runs against.
#   1 or prod     -> the internal PolyU JAS pages (sign-in and campus network/VPN required)
#   0 or demo     -> the public demo site
#   no line       -> site_profiles.json's "default" (prod in the released package, demo in a dev checkout)
# Any other value refuses to start, so a typo cannot silently screen the wrong site.
#
# An empty value is NOT the same as no line: `JES_SITE_MODE=` selects the DEMO. This template
# leaves it empty, so do not copy this file over a working .env as-is - fill the line in, or
# delete it and take site_profiles.json's default. A real installation writes `JES_SITE_MODE=1`.
JES_SITE_MODE=
